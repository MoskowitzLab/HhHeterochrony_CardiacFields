# Downsampled

## JCF

```{r}
# Define the number of WT cells
wt_count_jcf <- psts %>% filter(Genotype == "Wt", lineage == "JCF lineage") %>% nrow()
mut_count_jcf <- psts %>% filter(Genotype == "Mut", lineage == 'JCF lineage') %>% nrow()

wt_count_shf <- psts %>% filter(Genotype == "Wt", lineage == "SHF lineage") %>% nrow()
mut_count_shf <- psts %>% filter(Genotype == "Mut", lineage == 'SHF lineage') %>% nrow()

# Filter the 'Mut' samples and downsample to match 'Wt' count
mut_sample_jcf <- psts %>%
  filter(Genotype == "Mut", lineage == 'JCF lineage') %>%
  sample_n(wt_count_jcf)

# Filter the 'Wt' samples
wt_sample_jcf <- psts %>%
  filter(Genotype == "Wt", lineage == 'JCF lineage')

# Filter the 'Mut' samples and downsample to match 'Wt' count
mut_sample_shf <- psts %>%
  filter(Genotype == "Mut", lineage == 'SHF lineage') %>%
  sample_n(wt_count_shf)

# Filter the 'Wt' samples
wt_sample_shf <- psts %>%
  filter(Genotype == "Wt", lineage == 'SHF lineage')

# Downsample mutant cells to match WT cell count
downsampled_psts <- bind_rows(mut_sample_jcf, wt_sample_jcf, mut_sample_shf, wt_sample_shf)
table(downsampled_psts$Genotype, downsampled_psts$lineage)
```

