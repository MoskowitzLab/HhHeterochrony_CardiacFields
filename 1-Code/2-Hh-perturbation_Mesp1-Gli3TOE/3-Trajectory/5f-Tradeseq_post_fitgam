# Start vs End test

```{r}
startRes <- startVsEndTest(v6.1_sce_tradeseq, global = F, lineages = T, l2fc = 0.5)
startRes <- as.data.frame(startRes)
startRes_list <- list(
  SHF = dplyr::select(startRes, contains('lineage1')),
  JCF = dplyr::select(startRes, contains('lineage2'))
)
startRes_list <- lapply(startRes_list, function(x) {
  x %>%
    mutate(across(matches("pvalue", ignore.case = TRUE), 
                  ~ p.adjust(.x, method = "fdr"), 
                  .names = "padj")) %>%
    filter(padj < 0.05) %>%
    arrange(across(starts_with('logFC')))
})
```

