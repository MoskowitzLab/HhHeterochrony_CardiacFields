```{r, fig.width=5, fig.height=5}
v6.1[[]] %>%
  ggplot(aes(x= CM_UCell_kNN, y = Hh_activity_UCell_kNN, color = Avg_pseudotime.scaled)) +
  geom_point() +
  theme_minimal()+
  scale_color_gradient(low = "gray", high = "#FFEA46FF", breaks = c(0,0.5, 1)) +
  theme(axis.ticks = element_blank(), plot.background = element_blank(), panel.grid = element_blank()) +
  border() + 
  labs(x='CM score', y= 'Hh activity score', color = 'Pseudotime') +
  ylim(0, 0.2) + xlim(0, 0.8) +
  coord_equal(ratio = 0.8/0.2)
ggsave("plots/scatter_hhactivity_cmscore.png", width = 5, height = 5, bg='transparent')
