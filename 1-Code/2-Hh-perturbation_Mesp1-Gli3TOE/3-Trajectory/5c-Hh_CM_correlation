How about smoothing the scores with magic

```{r}
library(Rmagic)
library(SingleCellExperiment)
library(tidyverse)
library(reticulate)
library(viridis)
library(Seurat)
use_condaenv('./B-CondaEnvs/Pymagic')
```
```{r}
scores_matrix <- dplyr::select(v6.1[[]], CM_UCell, Hh_activity_UCell)
scores_matrix_afterMAGIC_auto <- magic(scores_matrix, genes = "all_genes", t='auto') # selected t =11
scores_matrix_afterMAGIC_auto$operator
```

```{r}
scores_matrix_afterMAGIC_auto$result %>%
  ggplot(aes(x= CM_UCell, y = Hh_activity_UCell)) +
  geom_point()
```

