```{r}
pseudo.paths <- slingCurves(v6.1_sce)
cluster_colors <- c(`JCF` = "#A5D171", `SHF`= "#8FA2F2" ,`ECM` = "#FF8C00" ,`CM` = "#FF4500") 
p1 <- DimPlot(v6.1, cols = cluster_colors, pt.size = 0.6, label = F) +
  coord_fixed() + 
  NoLegend() +
  NoAxes()+
  guides_truncated() +
  xlab("UMAP1") + ylab("UMAP2") +
  ggtitle("") &
  theme(rect = element_rect(fill = 'transparent'))
for (path in pseudo.paths) {
    embedded <- data.frame(path$s[path$ord,])
    p1 <- p1 + geom_path(data=embedded, aes(x=umap_1, y=umap_2), linewidth  =1.2)
}
p1
ggsave("plots/UMAP_coloredByCellID_curves.png", width = 4, height = 4, bg="transparent", dpi = 1200)
