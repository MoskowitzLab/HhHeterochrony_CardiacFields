## WT and Mut trajectories separately

Run slingshot_conditions and plot MST to see if they're similar across conditions

```{r}
sdss <- slingshot_conditions(v6.1_sce, v6.1_sce$Genotype, approx_points = FALSE,
                             extend = "n", reweight = T, reassign = T)

sdss$condition_id <- names(sdss)
sdss$mapping <- matrix(rep(1:2, each = 2), nrow = 2, ncol = 2, byrow = TRUE)
sds <- do.call(merge_sds, sdss)
```

```{r}
df<-bind_cols(
  as.data.frame(reducedDims(v6.1_sce)$UMAP),
  as.data.frame(colData(v6.1_sce)[, !colnames(colData(v6.1_sce)) == "slingshot"])
  )

df <- full_join(
  df %>% select(umap_1, umap_2, SCT_snn_res.0.5, Genotype) %>%
    rownames_to_column("cells"),
  slingPseudotime(sds) %>% 
    as.data.frame() %>%
    mutate(cells = rownames(.))
) %>%
  pivot_longer(starts_with("Lineage"), names_to = "Curve", values_to = "pst")

p4 <- ggplot(df, aes(x = umap_1, y = umap_2, col = Genotype)) +
  geom_point(size = .7, alpha = .1) +
  scale_color_brewer(palette = "Accent") +
  coord_fixed()
for (batch in unique(v6.1_sce$Genotype)) {
  sds_cond <- sdss[[batch]]
  for (i in 1:2) {
    p4 <- p4 +  
      geom_path(data = slingCurves(sds_cond)[[i]]$s[slingCurves(sds_cond)[[i]]$ord, ] %>%
                  as.data.frame() %>%
                  mutate(Genotype = batch), 
                size = 1.5)   
  }
}

p4
ggsave("plots/Trajectory_condiments_slingshot_conditions.pdf")
```
