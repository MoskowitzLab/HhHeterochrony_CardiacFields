```{r}
# Scale and reverse pst
scale_reverse_pst <- function(pst) {
  pst_scaled <- pst / max(pst, na.rm = T)
  pst_revertsed <- 1 - pst_scaled
  return(pst_revertsed)
}

```

```{r}
pst_df <- data.frame(colData(v6.1_sce)[, grep("pseudotime" ,colnames(colData(v6.1_sce)), ignore.case = T)])
pst_df_scaled <- map_df(pst_df, scale_reverse_pst)
colnames(pst_df_scaled) <- paste0(colnames(pst_df_scaled), ".scaled")

colData(v6.1_sce) <- cbind(colData(v6.1_sce), pst_df_scaled )
v6.1[[]] <- cbind(v6.1[[]], pst_df_scaled)
saveRDS(v6.1_sce, "v6.1_sce_slingshot.rds")
